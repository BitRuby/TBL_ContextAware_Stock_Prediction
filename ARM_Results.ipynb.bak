    "cells": [
        {
            "cell_type": "code",
            "id": "#VSC-50a769c3",
            "metadata": {
                "language": "python"
            },
            "source": [
                "from Association_Rule_Mining import filter_apriori, create_tweet_dataset, create_continous_dataset, create_categorize_dataset, perform_apriori, create_triple_barrier_labeling",
                "import warnings",
                "import pandas as pd",
                "warnings.filterwarnings('ignore')"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-c94aade1",
            "metadata": {
                "language": "python"
            },
            "source": [
                "continous_df = create_continous_dataset().dropna()"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-358e4088",
            "metadata": {
                "language": "python"
            },
            "source": [
                "continous_df"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-99050b68",
            "metadata": {
                "language": "python"
            },
            "source": [
                "continous_df_with_tbl = create_triple_barrier_labeling(continous_df)"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-3082774c",
            "metadata": {
                "language": "python"
            },
            "source": [
                "continous_df_with_tbl"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-f1d01ac9",
            "metadata": {
                "language": "python"
            },
            "source": [
                "tweets_df = create_tweet_dataset().dropna()"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-8483d727",
            "metadata": {
                "language": "python"
            },
            "source": [
                "tweets_df"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-6d5d73aa",
            "metadata": {
                "language": "python"
            },
            "source": [
                "categorized_dataset = pd.concat([create_categorize_dataset(continous_df), create_categorize_dataset(tweets_df[['compound_above_rolling', 'sentiment_compound_high', 'sentiment_compound_above_mean', 'sentiment_compound_label', 'sentiment_compound_score_increasing']])], axis=1).dropna()"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-32c3c395",
            "metadata": {
                "language": "python"
            },
            "source": [
                "categorized_dataset_1 = categorized_dataset[[\"close_increasing_0\", \"close_increasing_1\", \"SMA_10_Increasing_0\", \"SMA_10_Increasing_1\", \"crossover_0\", \"crossover_1\", 'ROC_Increasing_0', 'ROC_Increasing_1', \"RSI_Above_50_0\", \"RSI_Above_50_1\", \"sentiment_compound_above_mean_1\",  \"sentiment_compound_above_mean_0\"]]",
                "apriori_scores_1 = perform_apriori(categorized_dataset_1, min_support = 0.02)",
                "filter_apriori(apriori_scores_1, target_label=\"close_increasing_1\", min_antecedents=5, min_lift=1.1)"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-41d69017",
            "metadata": {
                "language": "python"
            },
            "source": [
                "categorized_dataset_2 = categorized_dataset[[\"trade_profitable_0\", \"trade_profitable_1\", \"SMA_10_Increasing_0\", \"SMA_10_Increasing_1\", \"crossover_0\", \"crossover_1\", 'ROC_Increasing_0', 'ROC_Increasing_1', \"RSI_Above_50_0\", \"RSI_Above_50_1\", \"sentiment_compound_above_mean_1\",  \"sentiment_compound_above_mean_0\"]]",
                "apriori_scores_2 = perform_apriori(categorized_dataset_2, min_support = 0.02)",
                "filter_apriori(apriori_scores_2, target_label=\"trade_profitable_1\", min_antecedents=5, min_lift=1.02)"
            ]
        },
        {
            "cell_type": "code",
            "id": "#VSC-d05ac74e",
            "metadata": {
                "language": "python"
            },
            "source": [
                "categorized_dataset_with_tbl = pd.concat([create_categorize_dataset(continous_df_with_tbl[[\"volatility_label\", \"RSI\", \"ROC\", \"sma_label\", \"momentum_label\", \"close_label\", \"macd_label\"]]), create_categorize_dataset(tweets_df[['sentiment_compound_label']])], axis=1).dropna()"
            ]
        }
    ]
}